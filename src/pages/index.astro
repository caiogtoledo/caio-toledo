---
import GlobalNav from '../components/ui/GlobalNav.astro';
import Footer from '../components/Footer.jsx';
import Hero from '../components/portfolio/Hero.astro';
import Skills from '../components/portfolio/Skills.astro';
import ProjectsShowcase from '../components/portfolio/ProjectsShowcase.astro';
import Experience from '../components/portfolio/Experience.astro';
import Contact from '../components/portfolio/Contact.astro';
import about from '../data/about.js';
import translations from '../data/translations.js';

// Determine language (default EN)
const url = new URL(Astro.request.url);
const lang = url.searchParams.get('lang') ?? 'en';
const t = translations[lang] || translations.en;

const pageTitle = `${about.name} - ${t.about.title}`;
const pageDescription = t.about.bio;
const canonicalURL = Astro.url.href;
---

<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="author" content={about.name} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="pt_BR" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<script type="application/ld+json">{JSON.stringify(personSchema)}</script>
<style>
html {
  scroll-behavior: smooth;
}

body {
  overflow-x: hidden;
}
</style>
</head>
  <body>
    <GlobalNav />
    <main>
      <Hero />
      <Skills />
      <ProjectsShowcase />
      <Experience />
      <Contact />
    </main>
    <Footer />
  </body>
</html>
